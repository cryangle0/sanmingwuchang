{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!migration/fixtures",
      "!migration/reports",
      "!unity/Library",
      "!unity/Temp",
      "!unity/Obj",
      "!unity/Build",
      "!unity/Builds",
      "!unity/Logs",
      "!unity/ProjectSettings",
      "!unity/UserSettings",
      "!unity/MemoryCaptures",
      "!unity/Recordings",
      "!unity/.utmp",
      "!apps/web/public/basis/basis_transcoder.js",
      "!unity/Assets/ProceduralHeroes/**/*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
