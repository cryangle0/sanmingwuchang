{
  "name": "journey-west-great-brawl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev -w @jwgb/web",
    "dev:server": "npm run dev -w @jwgb/server",
    "build": "npm run build -w @jwgb/web && npm run build -w @jwgb/server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:compile": "tsx tools/content/compile-authoritative-content.ts && biome format --write packages/content/src/authoritative.generated.ts",
    "content:compile:unity": "tsx tools/content/compile-unity-gameplay-content.ts",
    "map:compile": "tsx tools/map/compile-map-geometry.ts && biome format --write packages/content/src/map-geometry.generated.ts",
    "map:authority": "tsx tools/map/verify-map-authority.ts",
    "models:verify": "npm run models:verify:delivery && npm run models:verify:web",
    "models:verify:delivery": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/models/verify-model-delivery.ps1",
    "models:verify:web": "tsx tools/models/verify-web-model-assets.ts",
    "models:verify:render": "node tools/web/verify-web-models.mjs",
    "models:convert:map": "node tools/models/convert-map-assets.mjs",
    "models:import:free-map": "node tools/models/import-free-map-assets.mjs",
    "models:import:global-scenes": "node tools/models/import-global-scene-assets.mjs",
    "models:import:grassworks": "node tools/models/import-grassworks-vegetation.mjs",
    "models:convert:lush-tree": "node tools/models/convert-lush-tree.mjs",
    "models:convert:wukong": "node tools/models/convert-wukong-animation-assets.mjs",
    "models:convert:animated": "node tools/models/convert-character-animation-assets.mjs",
    "models:capture:wukong": "node tools/models/capture-wukong-glb.mjs",
    "models:capture:animated": "node tools/models/capture-character-glb.mjs",
    "models:normalize": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/models/normalize-model-sidecars.ps1",
    "audio:prepare:skills": "node tools/audio/prepare-hero-skill-audio.mjs",
    "web:oss:upload": "tsx tools/deploy/upload-web-assets.ts",
    "deploy:web": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/deploy/deploy-web-demo.ps1",
    "verify:web:production": "tsx tools/deploy/verify-web-demo.ts",
    "verify:web:browser": "node tools/web/verify-web-production.mjs",
    "verify:web:local-map": "node tools/web/verify-web-local-map.mjs",
    "verify:web:grassworks": "node tools/web/verify-web-grassworks.mjs",
    "verify:web:global-scenes": "npm run verify:web:grassworks",
    "verify:web:local-services": "tsx tools/web/verify-web-local-services.mjs",
    "verify:web:settings": "node tools/web/verify-web-settings.mjs",
    "verify:web:bandwidth": "tsx tools/web/verify-web-bandwidth.ts",
    "migration:fixtures": "tsx tools/migration/export-core-fixtures.ts && tsx tools/migration/export-sim-fixtures.ts && tsx tools/migration/export-map-fixtures.ts && tsx tools/migration/export-match-fixtures.ts && biome format --write --no-errors-on-unmatched migration/fixtures/core-v1.json migration/fixtures/sim-v1.json migration/fixtures/map-v1.json migration/fixtures/match-v1.json migration/fixtures/seeds-v1.json",
    "unity:architecture": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/verify-architecture.ps1",
    "unity:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/setup-project.ps1",
    "unity:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-tests.ps1",
    "unity:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/build.ps1 -Target windows",
    "unity:build:windows-network-debug": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/build.ps1 -Target windows-network-debug",
    "unity:smoke:windows-menu": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-windows-menu-smoke.ps1",
    "unity:smoke:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-windows-client-smoke.ps1",
    "unity:build:windows-stress": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/build.ps1 -Target windows-stress",
    "unity:sample:windows-stress": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-windows-stress.ps1",
    "unity:build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/build.ps1 -Target android",
    "unity:build:linux-server": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/build.ps1 -Target linux-server",
    "unity:smoke:linux-server": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-linux-server-smoke.ps1",
    "unity:smoke:netcode": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-netcode-smoke.ps1",
    "unity:smoke:netcode-rematch": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-netcode-smoke.ps1 -Rematch",
    "unity:smoke:netcode-interactive": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-netcode-smoke.ps1 -Interactive",
    "unity:smoke:netcode-adverse": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-netcode-smoke.ps1 -Adverse -TimeoutSeconds 90 -ServerCaptureTick 480",
    "unity:smoke:netcode-visual": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-netcode-smoke.ps1 -Visual",
    "unity:smoke:netcode-load": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-netcode-load.ps1",
    "unity:smoke:netcode-reconnect": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/unity/run-netcode-reconnect.ps1",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check . && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/node": "25.9.2",
    "@types/three": "0.165.0",
    "@types/ws": "8.18.1",
    "ali-oss": "^6.23.0",
    "draco3dgltf": "^1.5.7",
    "esbuild": "0.28.1",
    "meshoptimizer": "^1.0.1",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "tsx": "4.22.4",
    "typescript": "5.5.4",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
